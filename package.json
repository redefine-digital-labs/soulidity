{
  "name": "clawnews",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "cleanup": "bash scripts/cleanup-artifacts.sh",
    "dev": "tsx src/main.ts",
    "test": "npm run validate:v6-plan && npm run prisma:generate && vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "typecheck:root": "npm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "typecheck:web": "npm --prefix web run typecheck",
    "typecheck": "npm run typecheck:root && npm run typecheck:web",
    "build:web:production-env": "CLAWNEWS_LOAD_ENV_LOCAL=false npm --prefix web run build",
    "publish:soulidity": "tsx scripts/publish-soulidity-and-sync.ts",
    "smoke:soulidity": "tsx scripts/smoke-soulidity.ts",
    "smoke:phase2": "tsx scripts/phase2-smoke.ts",
    "phase2:prepare": "tsx scripts/phase2-mainnet-prepare.ts",
    "phase2:fund": "tsx scripts/phase2-mainnet-fund.ts",
    "collect": "tsx src/collector/run.ts",
    "collect:x": "tsx src/collector/run.ts x",
    "produce": "tsx src/producer/run.ts",
    "publish": "tsx src/publisher/run.ts",
    "seed:achievements": "tsx src/db/seed-achievements.ts",
    "scan:skills": "tsx src/collector/scan-skills.ts",
    "sync:v6-plan": "tsx scripts/export-v6-plan-json.ts",
    "validate:v6-plan": "tsx scripts/export-v6-plan-json.ts --check && node scripts/validate-v6-plan.mjs",
    "vercel:sync-production-env": "tsx scripts/sync-vercel-production-env.ts"
  },
  "dependencies": {
    "@mysten/sui": "^2.16.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.8.0",
    "@soulidity/sdk": "file:./packages/soulidity-sdk",
    "dotenv": "^17.4.2",
    "grammy": "^1.42.0",
    "jsonrepair": "^3.13.3",
    "node-cron": "^4.2.1",
    "openai": "^6.34.0",
    "p-limit": "^7.3.0",
    "pg": "^8.20.0",
    "posthog-node": "^5.30.6",
    "prisma": "^7.8.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "@types/node-fetch": "^2.6.13",
    "@types/pg": "^8.20.0",
    "@types/xml2js": "^0.4.14",
    "jsdom": "^29.0.2",
    "knip": "^6.11.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "@hono/node-server": "1.19.14",
    "hono": "4.12.29",
    "vite": "7.3.2"
  }
}
