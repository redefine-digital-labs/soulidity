{
  "name": "clawnews",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "typecheck:root": "npm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:root && npm --prefix web run typecheck",
    "collect": "tsx src/collector/run.ts",
    "collect:x": "tsx src/collector/run.ts x",
    "produce": "tsx src/producer/run.ts",
    "publish": "tsx src/publisher/run.ts",
    "seed:achievements": "tsx src/db/seed-achievements.ts",
    "scan:skills": "tsx src/collector/scan-skills.ts",
    "mcp:review-memory": "tsx src/mcp/review-memory/server.ts",
    "review-memory:backfill": "tsx scripts/review-memory-backfill.ts",
    "review-memory:dedupe": "tsx scripts/review-memory-dedupe.ts",
    "review-memory:migrate-active-state": "tsx scripts/review-memory-migrate-active-state.ts",
    "review-memory:server:up": "bash scripts/review-memory-run-local.sh",
    "review-memory:docker:up": "docker compose -f docker/review-memory/docker-compose.yml up -d --build",
    "review-memory:docker:db:up": "docker compose -f docker/review-memory/docker-compose.yml up -d postgres",
    "review-memory:docker:down": "docker compose -f docker/review-memory/docker-compose.yml down",
    "review-memory:docker:logs": "docker compose -f docker/review-memory/docker-compose.yml logs -f mnemo-server"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "dotenv": "^17.3.1",
    "grammy": "^1.30.0",
    "jsonrepair": "^3.13.3",
    "node-cron": "^3.0.3",
    "openai": "^6.25.0",
    "p-limit": "^7.3.0",
    "pg": "^8.19.0",
    "prisma": "^7.5.0",
    "rss-parser": "^3.13.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
