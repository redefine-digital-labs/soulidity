{
  "name": "clawnews",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "typecheck:root": "npm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "typecheck:new-web": "npm --prefix new-web run typecheck",
    "typecheck": "npm run typecheck:root && npm --prefix web run typecheck && npm run typecheck:new-web",
    "publish:soulidity": "tsx scripts/publish-soulidity-and-sync.ts",
    "collect": "tsx src/collector/run.ts",
    "collect:x": "tsx src/collector/run.ts x",
    "produce": "tsx src/producer/run.ts",
    "publish": "tsx src/publisher/run.ts",
    "seed:achievements": "tsx src/db/seed-achievements.ts",
    "scan:skills": "tsx src/collector/scan-skills.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "dotenv": "^17.4.1",
    "grammy": "^1.42.0",
    "jsonrepair": "^3.13.3",
    "node-cron": "^4.2.1",
    "openai": "^6.34.0",
    "p-limit": "^7.3.0",
    "pg": "^8.20.0",
    "prisma": "^7.7.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/node-fetch": "^2.6.13",
    "@types/pg": "^8.20.0",
    "@types/xml2js": "^0.4.14",
    "jsdom": "^29.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
