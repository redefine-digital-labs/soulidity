# Soulidity smoke harness wallets and config.
# Used by scripts/smoke-soulidity.ts for stage 7a (testnet) and 7b (mainnet)
# of docs/plans/2026-05-03-soulidity-2sigs-fast-path.md.
#
# Copy this file to .env.soulidity-smoke and fill in real values.
# Never commit the populated file. Each key controls a wallet that signs and
# pays gas/USDC/WAL during the matrix run.
#
# Pre-funding requirements per wallet:
#   testnet — 5 SUI from `sui client faucet` + 5 testnet WAL from
#             `walrus get-wal --context testnet --amount 5000000000`.
#   mainnet — at least 5 SUI for gas, 100 USDC for buy flow, 5 WAL for blobs.

# Bech32 Sui private keys (suiprivkey1...) for the three smoke roles.
SMOKE_PUBLISHER_KEY=suiprivkey1...   # creator / mint / collection-launch wallet
SMOKE_BUYER_KEY=suiprivkey1...       # secondary purchaser for buy flow row
SMOKE_AGENT_KEY=suiprivkey1...       # grant recipient for grant/access rows

# Web/back-end the harness will hit for mirror sync calls. Default works for
# `npm --prefix web run dev` on the same host.
SOULIDITY_WEB_URL=http://localhost:3000

# Auth for the public mirror routes — per signer role.
#
# Each first-party mirror route enforces that the signed-in wallet identity
# matches the on-chain transaction sender (assertTransactionSender in
# web/lib/soulidity/server.ts). The matrix mixes publisher-signed,
# buyer-signed, and agent-signed steps, so a single global cookie cannot
# service every row. The harness picks mirror auth from `step.signer`, so
# provide one cookie OR bearer token per role whose rows hit a mirror.
#
# At least one of authorization / cookie must be set for each role whose
# rows mirror through /api/* — otherwise that role's mirror calls return
# 401 / 403 and the matrix row fails.
#
# Publisher (mint, list, batch publish, collection create/list, grant)
# SMOKE_PUBLISHER_AUTHORIZATION=Bearer ...
# SMOKE_PUBLISHER_COOKIE=clawnews_session=...; Path=/; HttpOnly
#
# Buyer (purchase row)
# SMOKE_BUYER_AUTHORIZATION=Bearer ...
# SMOKE_BUYER_COOKIE=clawnews_session=...; Path=/; HttpOnly
#
# Agent (grant-recipient access rows that mirror through agent API)
# SMOKE_AGENT_AUTHORIZATION=Bearer ...
# SMOKE_AGENT_COOKIE=clawnews_session=...; Path=/; HttpOnly

# Acceptance matrix (PTB-replayer scenario). Pick one source:
#   - SOULIDITY_SMOKE_SCENARIO_FILE: path to a JSON file with the row+steps
#     shape documented in scripts/scenarios/soulidity-smoke-matrix.example.json.
#   - SOULIDITY_SMOKE_SCENARIO_JSON: inline JSON string (CI-friendly).
SOULIDITY_SMOKE_SCENARIO_FILE=scripts/scenarios/soulidity-smoke-matrix.example.json
# SOULIDITY_SMOKE_SCENARIO_JSON={"rows":[...]}
