{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    "generated/prisma/**",
    "docs/legacy/**",
    "web/.next/**",
    "desktop/**/dist/**",
    "desktop/**/out/**",
    "desktop/apps/desktop/release/**",
    "desktop/scripts/gen-persona/**",
    "desktop/vitest.config.ts",
    "prisma/backfill-accounts.ts",
    "prisma/backfill-handles.ts",
    "scripts/backfill-news-posts.ts",
    "scripts/check-accounts.ts",
    "scripts/e2e-check-env.ts",
    "scripts/e2e-setup-agents.ts",
    "tests/mocks/server-only.ts"
  ],
  "ignoreDependencies": [
    "@soulidity/shared",
    "fflate",
    "jose",
    "@prisma/client",
    "react",
    "react-dom",
    "@types/node-fetch",
    "@types/xml2js",
    "prisma-client"
  ],
  "rules": {
    "exports": "off",
    "types": "off",
    "duplicates": "off"
  },
  "paths": {
    "@db/*": ["src/db/*"],
    "@shared/*": ["src/shared/*"]
  },
  "entry": [
    "src/{collector,producer,publisher}/run.ts",
    "src/db/seed-achievements.ts",
    "scripts/**/*.{ts,mts,mjs}",
    "tests/{bot,db,producer,scripts}/**/*.test.ts",
    "tests/helpers/**/*.ts",
    "tests/mocks/**/*.ts",
    "tests/repository-health-cleanup.test.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{ts,mts,mjs}",
    "tests/{bot,db,producer,scripts,helpers}/**/*.{ts,tsx}",
    "tests/mocks/**/*.ts",
    "tests/repository-health-cleanup.test.ts",
    "prisma/migrations/**/*.{ts,mjs}"
  ],
  "workspaces": {
    "web": {
      "paths": {
        "@/*": ["./*"],
        "@db/*": ["../src/db/*"]
      },
      "entry": [
        "app/**/{page,layout,route,error,global-error,loading,not-found,opengraph-image,twitter-image,icon,apple-icon,sitemap,robots,manifest}.{ts,tsx}",
        "instrumentation-client.ts",
        "proxy.ts",
        "next.config.{ts,mjs,js}",
        "scripts/**/*.{ts,mts,mjs}",
        "lib/soulidity/asset-access.ts",
        "../tests/new-web/**/*.test.{ts,tsx}",
        "../tests/web/**/*.test.{ts,tsx}",
        "app/**/*.test.{ts,tsx}"
      ],
      "project": [
        "**/*.{ts,tsx}",
        "../tests/new-web/**/*.{ts,tsx}",
        "../tests/web/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "tailwindcss",
        "tsx"
      ]
    },
    "desktop/apps/desktop": {
      "entry": [
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/main.tsx",
        "electron.vite.config.ts",
        "src/**/*.{test,spec}.{ts,tsx}",
        "../../../tests/desktop/**/*.test.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "../../../tests/desktop/**/*.{ts,tsx}"
      ],
      "ignoreFiles": [
        "src/renderer/*.d.ts"
      ]
    },
    "desktop/packages/backend": {
      "entry": [
        "src/index.ts",
        "src/agent/skills/**/*.ts"
      ],
      "project": [
        "src/**/*.ts"
      ],
      "ignoreDependencies": [
        "write-excel-file"
      ]
    },
    "desktop/packages/shared": {
      "entry": [
        "src/index.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  }
}
