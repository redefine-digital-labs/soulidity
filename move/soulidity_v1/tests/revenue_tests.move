#[test]
fun separate_payers_accumulate_income_and_keep_version_entitlements(){let mut sc=fixtures::setup(15,0,0,0,0,0);buy(&mut sc,30);sc.next_tx(@0xc);buy(&mut sc,30);sc.next_tx(@0xa);let p:Product<USD> = sc.take_shared();let c:Config<USD> = sc.take_shared();assert!(revenue::balance(catalog::income(&p))==28 && revenue::collected(catalog::income(&p))==28 && revenue::revision(catalog::income(&p))==2 && revenue::balance(economics::income(&c))==2 && catalog::access_held(&p,1,@0xb) && catalog::access_held(&p,1,@0xc),0);test_scenario::return_shared(p);test_scenario::return_shared(c);sc.end();}
#[test]
#[expected_failure(abort_code=1,location=soulidity_maker_manufacturing::maker_catalog)]
fun another_product_control_cannot_withdraw_income(){let mut sc=fixtures::setup(15,0,0,0,0,0);buy(&mut sc,30);sc.next_tx(@0xa);let original:Product<USD> = sc.take_shared();let id=object::id(&original);test_scenario::return_shared(original);let c:Config<USD> = sc.take_shared();let other=catalog::create_maker(&c,0,sc.ctx());test_scenario::return_shared(c);sc.next_tx(@0xa);let mut p:Product<USD> = sc.take_shared_by_id(id);let mut cap=control(&mut sc,other);catalog::withdraw_income(&mut p,&mut cap,1,14,@0x9,fixtures::h(40),sc.ctx());test_scenario::return_shared(p);sc.return_to_sender(cap);sc.end();}
#[test]
#[expected_failure(abort_code=1,location=soulidity_foundation::economics)]
fun another_config_admin_cannot_withdraw_protocol_income(){let mut sc=fixtures::setup(15,0,0,0,0,0);buy(&mut sc,30);sc.next_tx(@0xa);let original:Config<USD> = sc.take_shared();let id=object::id(&original);test_scenario::return_shared(original);let old_admin:Admin=sc.take_from_sender();let old=object::id(&old_admin);sc.return_to_sender(old_admin);let auth:soulidity_foundation::economics::Authority=sc.take_from_sender();soulidity_v1::native_binding::create_enabled_for_testing<USD>(&auth,1000,500,0,@0xf,sc.ctx());sc.return_to_sender(auth);sc.next_tx(@0xa);let mut c:Config<USD> = sc.take_shared_by_id(id);let ids=sc.ids_for_sender<Admin>();let mut other=option::none();ids.do_ref!(|n|{if(*n!=old)other=option::some(*n)});let other=other.destroy_some();let mut admin:Admin=sc.take_from_sender_by_id(other);economics::withdraw_income(&mut c,&mut admin,1,1,@0x9,fixtures::h(40),sc.ctx());test_scenario::return_shared(c);sc.return_to_sender(admin);sc.end();}
fun control(sc:&mut Scenario,product:ID):Control{let mut found=option::none();sc.ids_for_sender<Control>().do_ref!(|id|{let cap:Control=sc.take_from_sender_by_id(*id);if(catalog::control_product(&cap)==product)found.fill(cap) else sc.return_to_sender(cap)});found.destroy_some()}

#[test]
fun control_market_sale_transfers_accumulated_income_and_preserves_access(){let mut sc=fixtures::setup(15,0,0,0,0,0);buy(&mut sc,30);sc.next_tx(@0xa);let mut p:Product<USD> = sc.take_shared();let product=object::id(&p);let mut cap:Control=sc.take_from_sender();catalog::lifecycle(&mut p,&mut cap,1,2);let mut c:Config<USD> = sc.take_shared();let clock=clock::create_for_testing(sc.ctx());let listing=soulidity_v1::market::list_control(cap,&p,&mut c,101,1000,1,0,&clock,sc.ctx());clock::destroy_for_testing(clock);test_scenario::return_shared(p);test_scenario::return_shared(c);sc.next_tx(@0xc);let p:Product<USD> = sc.take_shared_by_id(product);let mut c:Config<USD> = sc.take_shared();let mut l:soulidity_market::market::Listing<Control,USD> = sc.take_shared_by_id(listing);let clock=clock::create_for_testing(sc.ctx());let hash=soulidity_v1::market::manifest_hash(&l);let quote=soulidity_v1::market::control_quote_hash(&l,&mut c,@0xc);soulidity_v1::market::buy_control(&mut l,&p,&mut c,0,hash,quote,0,fixtures::h(50),coin::mint_for_testing<USD>(101,sc.ctx()),&clock,sc.ctx());assert!(revenue::balance(catalog::income(&p))==14 && catalog::access_held(&p,1,@0xb),0);test_scenario::return_shared(l);test_scenario::return_shared(p);test_scenario::return_shared(c);clock::destroy_for_testing(clock);sc.next_tx(@0xc);withdraw(&mut sc,1,14,40);sc.next_tx(@0x9);assert!(sum(&sc)==14,1);sc.end();}

