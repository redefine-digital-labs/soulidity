#[test_only]
module soulidity_v1::revenue_tests;
use sui::test_scenario::{Self,Scenario};
use sui::coin::{Self,Coin};
use sui::clock;
use soulidity_v1::fixtures::{Self,USD};
use soulidity_maker_manufacturing::maker_catalog::{Product,Control};
use soulidity_v1::catalog;
use soulidity_foundation::economics::{Self,Config,Admin};
use soulidity_foundation::revenue;

fun buy(sc:&mut Scenario,attempt:u8){let mut p:Product<USD> = sc.take_shared();let mut c:Config<USD> = sc.take_shared();let clock=clock::create_for_testing(sc.ctx());let hash=catalog::policy_hash(catalog::published(&p,1));let revision=economics::revision(&c);catalog::buy_access_for_testing(&mut p,&mut c,1,hash,revision,1000,fixtures::h(attempt),coin::mint_for_testing<USD>(15,sc.ctx()),&clock,sc.ctx());clock::destroy_for_testing(clock);test_scenario::return_shared(p);test_scenario::return_shared(c);}
fun sum(sc:&Scenario):u64{let mut sum=0;sc.ids_for_sender<Coin<USD>>().do_ref!(|id|{let c:Coin<USD> = sc.take_from_sender_by_id(*id);sum=sum+coin::value(&c);sc.return_to_sender(c)});sum}
fun deposit(sc:&mut Scenario,n:u64){let mut p:Product<USD> = sc.take_shared();let c:Config<USD> = sc.take_shared();catalog::deposit_income(&mut p,&c,coin::mint_for_testing<USD>(n,sc.ctx()));test_scenario::return_shared(p);test_scenario::return_shared(c);}
fun withdraw(sc:&mut Scenario,expected:u64,n:u64,attempt:u8){let mut p:Product<USD> = sc.take_shared();let mut cap:Control=sc.take_from_sender();catalog::withdraw_income(&mut p,&mut cap,expected,n,@0x9,fixtures::h(attempt),sc.ctx());test_scenario::return_shared(p);sc.return_to_sender(cap);}
#[test]
fun paid_access_exact_income_metadata_and_partial_exit(){
    let mut sc=fixtures::setup(15,0,0,0,0,0);buy(&mut sc,30);sc.next_tx(@0xa);let mut p:Product<USD> = sc.take_shared();let mut cap:Control=sc.take_from_sender();let mut c:Config<USD> = sc.take_shared();let mut admin:Admin=sc.take_from_sender();let a=catalog::access_record(&p,1,@0xb).destroy_some();assert!(catalog::access_product(&a)==object::id(&p) && catalog::access_version(&a)==1 && catalog::access_holder(&a)==@0xb && catalog::access_paid(&a)==15 && catalog::access_issued_at(&a)==0,0);assert!(catalog::access_policy_hash(&a)==catalog::policy_hash(catalog::published(&p,1)) && catalog::access_manifest(&a)==fixtures::h(1),1);assert!(revenue::root(catalog::income(&p))==object::id(&p) && revenue::balance(catalog::income(&p))==14 && revenue::balance(economics::income(&c))==1,2);
    catalog::withdraw_income(&mut p,&mut cap,1,4,@0x9,fixtures::h(40),sc.ctx());let r=revenue::receipt(catalog::income(&p),@0xa,fixtures::h(40)).destroy_some();assert!(revenue::receipt_root(&r)==object::id(&p) && revenue::receipt_actor(&r)==@0xa && revenue::receipt_recipient(&r)==@0x9 && revenue::receipt_amount(&r)==4 && revenue::receipt_balance(&r)==10 && revenue::receipt_revision(&r)==2,3);assert!(revenue::collected(catalog::income(&p))==14 && revenue::withdrawn(catalog::income(&p))==4,4);
    catalog::withdraw_income(&mut p,&mut cap,2,10,@0x9,fixtures::h(41),sc.ctx());economics::withdraw_income(&mut c,&mut admin,1,1,@0x9,fixtures::h(42),sc.ctx());assert!(revenue::balance(catalog::income(&p))==0 && revenue::withdrawn(catalog::income(&p))==14 && revenue::balance(economics::income(&c))==0,5);test_scenario::return_shared(p);test_scenario::return_shared(c);sc.return_to_sender(cap);sc.return_to_sender(admin);sc.next_tx(@0x9);assert!(sum(&sc)==15,6);sc.next_tx(@0xd);assert!(sum(&sc)==0,7);sc.end();
}
#[test]
fun current_control_inherits_income_old_creator_address_has_no_authority(){let mut sc=fixtures::setup(15,0,0,0,0,0);buy(&mut sc,30);sc.next_tx(@0xa);let cap:Control=sc.take_from_sender();transfer::public_transfer(cap,@0xc);sc.next_tx(@0xc);withdraw(&mut sc,1,14,40);sc.next_tx(@0xc);let p:Product<USD> = sc.take_shared();assert!(catalog::access_held(&p,1,@0xb) && !catalog::access_held(&p,1,@0xc) && catalog::creator(&p)==@0xa,0);test_scenario::return_shared(p);sc.next_tx(@0xa);assert!(sc.ids_for_sender<Control>().is_empty(),1);sc.next_tx(@0x9);assert!(sum(&sc)==14,2);sc.end();}
#[test]
fun paused_archived_product_and_paused_protocol_preserve_income_exit(){let mut sc=fixtures::setup(15,0,0,0,0,0);buy(&mut sc,30);sc.next_tx(@0xa);let mut p:Product<USD> = sc.take_shared();let mut cap:Control=sc.take_from_sender();let mut c:Config<USD> = sc.take_shared();let mut admin:Admin=sc.take_from_sender();catalog::lifecycle(&mut p,&mut cap,1,2);economics::configure(&mut c,&mut admin,0,9000,9000,999,@0xe,true);catalog::withdraw_income(&mut p,&mut cap,1,4,@0x9,fixtures::h(40),sc.ctx());catalog::lifecycle(&mut p,&mut cap,1,3);catalog::withdraw_income(&mut p,&mut cap,2,10,@0x9,fixtures::h(41),sc.ctx());economics::withdraw_income(&mut c,&mut admin,1,1,@0x9,fixtures::h(42),sc.ctx());test_scenario::return_shared(p);test_scenario::return_shared(c);sc.return_to_sender(cap);sc.return_to_sender(admin);sc.next_tx(@0x9);assert!(sum(&sc)==15,0);sc.end();}
#[test]
fun free_access_claim_persists_exact_entitlement_without_payment(){let mut sc=fixtures::setup(0,0,0,0,0,0);let mut p:Product<USD> = sc.take_shared();let c:Config<USD> = sc.take_shared();let mut clock=clock::create_for_testing(sc.ctx());clock::increment_for_testing(&mut clock,99);let hash=catalog::policy_hash(catalog::published(&p,1));catalog::claim_access_for_testing(&mut p,&c,1,hash,0,1000,fixtures::h(30),&clock,sc.ctx());let a=catalog::access_record(&p,1,@0xb).destroy_some();assert!(catalog::access_paid(&a)==0 && catalog::access_issued_at(&a)==99 && catalog::access_policy_hash(&a)==hash && catalog::access_held(&p,1,@0xb),0);assert!(revenue::balance(catalog::income(&p))==0 && revenue::revision(catalog::income(&p))==0,1);assert!(catalog::receipt(&p,@0xb,1,fixtures::h(30))==option::some(object::id(&p)),2);clock::destroy_for_testing(clock);test_scenario::return_shared(p);test_scenario::return_shared(c);sc.end();}
