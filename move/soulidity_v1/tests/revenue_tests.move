#[test]
fun public_deposit_only_increases_root_bound_income(){let mut sc=fixtures::setup(15,0,0,0,0,0);deposit(&mut sc,7);sc.next_tx(@0xa);let p:Product<USD> = sc.take_shared();assert!(revenue::balance(catalog::income(&p))==7 && revenue::collected(catalog::income(&p))==7 && revenue::withdrawn(catalog::income(&p))==0 && revenue::root(catalog::income(&p))==object::id(&p),0);test_scenario::return_shared(p);sc.next_tx(@0xa);withdraw(&mut sc,1,7,40);sc.next_tx(@0x9);assert!(sum(&sc)==7,1);sc.end();}
#[test]
fun paid_pack_income_is_separate_and_follows_pack_control(){let mut sc=fixtures::setup(0,0,0,0,0,0);sc.next_tx(@0xa);let maker:Product<USD> = sc.take_shared();let maker_id=object::id(&maker);let mut c:Config<USD> = sc.take_shared();let mut cap=control(&mut sc,maker_id);let id=catalog::create_pack_for_testing(&maker,1,&mut cap,&c,0,sc.ctx());test_scenario::return_shared(maker);test_scenario::return_shared(c);sc.return_to_sender(cap);sc.next_tx(@0xa);let mut pack:Product<USD> = sc.take_shared_by_id(id);let mut cap=control(&mut sc,id);catalog::publish(&mut pack,&mut cap,0,catalog::with_pack_key(catalog::version(fixtures::h(3),fixtures::h(4),1,15,0,0,0,0,0,@0xe,soulidity_maker_terms::maker_resale::rates(0,0),vector[b"free"],vector[],vector[fixtures::pack_def(b"free",2,10)],vector[],fixtures::scene()),b"pack"));transfer::public_transfer(cap,@0xc);test_scenario::return_shared(pack);sc.next_tx(@0xb);let mut pack:Product<USD> = sc.take_shared_by_id(id);let mut c:Config<USD> = sc.take_shared();let clock=clock::create_for_testing(sc.ctx());let hash=catalog::policy_hash(catalog::published(&pack,1));catalog::buy_access_for_testing(&mut pack,&mut c,1,hash,0,1000,fixtures::h(30),coin::mint_for_testing<USD>(15,sc.ctx()),&clock,sc.ctx());assert!(revenue::balance(catalog::income(&pack))==14 && catalog::access_held(&pack,1,@0xb),0);test_scenario::return_shared(pack);test_scenario::return_shared(c);clock::destroy_for_testing(clock);sc.next_tx(@0xc);let mut pack:Product<USD> = sc.take_shared_by_id(id);let mut cap=control(&mut sc,id);catalog::withdraw_income(&mut pack,&mut cap,1,14,@0x9,fixtures::h(40),sc.ctx());test_scenario::return_shared(pack);sc.return_to_sender(cap);let maker:Product<USD> = sc.take_shared_by_id(maker_id);assert!(revenue::balance(catalog::income(&maker))==0,1);test_scenario::return_shared(maker);sc.next_tx(@0x9);assert!(sum(&sc)==14,2);sc.end();}
