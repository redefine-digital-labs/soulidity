{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "walrus-uploader",
  "main": "worker/proxy.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],

  // Container running the existing Node 22 walrus uploader image. The
  // Dockerfile lives next to this config but copies repo-root paths, so the
  // build context must be the monorepo root.
  "containers": [
    {
      "class_name": "WalrusUploaderContainer",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      // standard-2 = 2 vCPU / 6 GiB / 10 GB disk. Walrus blob encoding is
      // CPU-heavy; sized to match historical Cloud Run usage.
      "instance_type": "standard-2",
      "max_instances": 20
    }
  ],

  // Workers→Container plumbing happens through a Durable Object. The DO
  // class is defined in worker/proxy.ts.
  "durable_objects": {
    "bindings": [
      { "name": "WALRUS_UPLOADER", "class_name": "WalrusUploaderContainer" }
    ]
  },

  // First deploy creates the SQLite-backed DO storage. Required even when
  // we don't use DO storage ourselves — the Container runtime needs it.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WalrusUploaderContainer"] }
  ],

  // Non-sensitive defaults forwarded into the container as POSIX env vars.
  // Sensitive values (TOKEN_SECRET, R2 keys) come from `wrangler secret put`.
  "vars": {
    "NEXT_PUBLIC_SUI_NETWORK": "mainnet",
    "CORS_ORIGIN": "https://www.soulidity.ai",
    "R2_BUCKET": "walrus-uploader-staging",
    "R2_PREFIX": "walrus-uploader",
    "R2_TOKEN_USAGE_PREFIX": "walrus-uploader/token-usage"
  },

  "observability": {
    "enabled": true
  }
}
