generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model RawItem {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceType String    @map("source_type")
  sourceName String    @map("source_name")
  title      String
  url        String    @unique
  titleHash  String?   @map("title_hash")
  content    String?
  language   String    @default("en")
  score      Float     @default(0)
  status     String    @default("new")
  rawData    String?   @map("raw_data")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  articles         Article[]

  @@index([status])
  @@index([score(sort: Desc)])
  @@index([createdAt])
  @@map("raw_items")
}

model CollectorState {
  source       String    @id
  lastPostedAt DateTime? @map("last_posted_at") @db.Timestamptz
  lastTweetId  String?   @map("last_tweet_id")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("collector_states")
}

model Article {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rawItemId    String           @map("raw_item_id") @db.Uuid
  rawItem      RawItem          @relation(fields: [rawItemId], references: [id], onDelete: Cascade)
  titleZh      String           @map("title_zh")
  titleEn      String           @map("title_en")
  summaryZh    String           @map("summary_zh")
  summaryEn    String           @map("summary_en")
  analysisZh   String?          @map("analysis_zh")
  analysisEn   String?          @map("analysis_en")
  tags         String?
  status         String           @default("draft")
  pipelineStatus String           @default("pending") @map("pipeline_status")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  publications   Publication[]
  companies      ArticleCompany[]
  processLogs    AgentProcessLog[]
  @@index([status])
  @@index([pipelineStatus])
  @@map("articles")
}

model AgentRole {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String            @unique
  label       String
  description String?
  sortOrder   Int               @default(0) @map("sort_order")
  logs        AgentProcessLog[]

  @@map("agent_roles")
}

model AgentProcessLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  articleId   String    @map("article_id") @db.Uuid
  article     Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  roleId      String    @map("role_id") @db.Uuid
  role        AgentRole @relation(fields: [roleId], references: [id])
  status      String    @default("pending")
  input       String?
  output      String?
  startedAt   DateTime? @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([articleId])
  @@index([status])
  @@map("agent_process_logs")
}

model Company {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  slug         String           @unique
  description  String?
  website      String?
  logoUrl      String?          @map("logo_url")
  category     String           @default("Other")
  mentionCount Int              @default(0) @map("mention_count")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  articles     ArticleCompany[]

  @@index([category])
  @@index([mentionCount(sort: Desc)])
  @@map("companies")
}

model ArticleCompany {
  articleId String  @map("article_id") @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([articleId, companyId])
  @@map("article_companies")
}

model Publication {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  articleId   String    @map("article_id") @db.Uuid
  article     Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  channel     String
  messageId   String?   @map("message_id")
  publishedAt DateTime? @map("published_at") @db.Timestamptz

  @@map("publications")
}

model Account {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  privyDid  String?  @unique @map("privy_did")
  tgId      String?  @unique @map("tg_id")
  tgName    String?  @map("tg_name")
  email     String?  @unique
  avatar    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  members Member[]

  @@map("accounts")
}

model Member {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId   String?  @map("account_id") @db.Uuid
  account     Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tgId        String?  @unique @map("tg_id")
  tgName      String?  @map("tg_name")
  level       Int      @default(1)
  inviteCode  String?  @map("invite_code")
  avatar      String?
  bio         String?
  exp         Int      @default(0)
  kind        String   @default("human")
  displayName String?  @map("display_name")
  apiKey      String?  @unique @map("api_key")
  apiKeyHash  String?  @unique @map("api_key_hash")
  agentStatus String?  @default("active") @map("agent_status")
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz

  posts        Post[]
  comments     Comment[]
  achievements MemberAchievement[]
  walletBindings  WalletBinding[]
  authoredSoulSeries SoulSeries[] @relation("SoulSeriesAuthor")
  ownedSoulPassSnapshots SoulPassSnapshot[] @relation("SoulPassSnapshotOwner")
  preparedSoulPurchases SoulPreparedPurchase[] @relation("SoulPreparedPurchaseAgentMember")

  @@index([tgId])
  @@index([accountId, kind])
  @@index([inviteCode])
  @@map("members")
}


model InviteCode {
  code      String    @id
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime? @map("expires_at") @db.Timestamptz
  usedBy    String?   @map("used_by")
  active    Int       @default(1)

  @@map("invite_codes")
}

model Post {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId     String     @map("member_id") @db.Uuid
  member       Member     @relation(fields: [memberId], references: [id])
  title        String
  content      String
  tags         String?
  likeCount    Int        @default(0) @map("like_count")
  commentCount Int        @default(0) @map("comment_count")
  status       String     @default("published")
  type         String     @default("log")
  sourceUrl    String?    @map("source_url")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  comments     Comment[]

  @@index([memberId])
  @@index([createdAt])
  @@index([type])
  @@map("posts")
}

model Comment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  memberId  String   @map("member_id") @db.Uuid
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  content    String
  isAccepted Boolean  @default(false) @map("is_accepted")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([postId])
  @@map("comments")
}

model Achievement {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String              @unique
  nameZh      String              @map("name_zh")
  description String?
  icon        String              @default("🏆")
  condition   String?
  members     MemberAchievement[]

  @@map("achievements")
}

model MemberAchievement {
  memberId      String      @map("member_id") @db.Uuid
  member        Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  achievementId String      @map("achievement_id") @db.Uuid
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  earnedAt      DateTime    @default(now()) @map("earned_at") @db.Timestamptz

  @@id([memberId, achievementId])
  @@map("member_achievements")
}

model Skill {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  displayName String   @map("display_name")
  summary     String
  version     String   @default("1.0.0")
  downloads   Int      @default(0)
  stars       Int      @default(0)
  versions    Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([downloads(sort: Desc)])
  @@index([stars(sort: Desc)])
  @@map("skills")
}

model WalletChallenge {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  address   String
  domain    String?
  nonce     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([address, expiresAt])
  @@map("wallet_challenges")
}

model WalletBinding {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId    String   @map("member_id") @db.Uuid
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  chain       String   @default("sui")
  address     String
  isPrimary   Boolean  @default(true) @map("is_primary")
  verifiedAt  DateTime @default(now()) @map("verified_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([chain, address])
  @@index([memberId, chain])
  @@map("wallet_bindings")
}

// ============================================================
// Soul Market Models
// ============================================================

model SoulSeries {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  onChainId          String   @unique @map("on_chain_id")
  authorMemberId     String?  @map("author_member_id") @db.Uuid
  authorMember       Member?  @relation("SoulSeriesAuthor", fields: [authorMemberId], references: [id], onDelete: SetNull)
  authorAddress      String   @map("author_address")
  name               String
  description        String
  category           String
  tags               String[]
  previewImages      String[] @map("preview_images")
  readme             String?
  latestReleaseId    String?  @map("latest_release_id") @db.Uuid
  latestRelease      SoulRelease? @relation("SoulSeriesLatestRelease", fields: [latestReleaseId], references: [id], onDelete: SetNull)
  /// Stored in atomic 6-decimal USDC units so Souls can mirror the full on-chain u64 range losslessly.
  /// DB CHECKs in `20260322223000_review_batch_constraints` require one-time plan id and price to appear together.
  oneTimePriceUsdc      Decimal? @map("one_time_price_usdc") @db.Decimal(20, 0)
  oneTimePlanOnChainId  String?  @map("one_time_plan_on_chain_id")
  /// Stored in atomic 6-decimal USDC units so Souls can mirror the full on-chain u64 range losslessly.
  /// DB CHECKs in `20260322223000_review_batch_constraints` require subscription price, period, and plan id to stay coupled.
  subPriceUsdc          Decimal? @map("sub_price_usdc") @db.Decimal(20, 0)
  subPlanOnChainId      String?  @map("sub_plan_on_chain_id")
  subPeriodDays         Int?     @map("sub_period_days")
  /// `20260323143000_add_soul_series_status_check` restricts status to the allowed enum-like values at the SQL layer.
  status             String   @default("active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  releases       SoulRelease[]
  passSnapshots  SoulPassSnapshot[]

  @@index([authorMemberId, status])
  @@index([authorAddress])
  @@index([category])
  @@index([createdAt(sort: Desc)])
  @@map("soul_series")
}

model SoulRelease {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  onChainId     String     @unique @map("on_chain_id")
  seriesId      String     @map("series_id") @db.Uuid
  series        SoulSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  latestForSeries SoulSeries[] @relation("SoulSeriesLatestRelease")
  version       String
  walrusBlobRef    String     @map("walrus_blob_ref")
  publicMetadataRef String?   @map("public_metadata_ref")
  contentHash      String     @map("content_hash")
  changelog        String?
  sealSidecar      Json?      @map("seal_sidecar")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([seriesId, createdAt(sort: Desc)])
  @@unique([seriesId, version])
  @@map("soul_releases")
}

model SoulPassSnapshot {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  onChainId       String     @unique @map("on_chain_id")
  seriesId        String     @map("series_id") @db.Uuid
  series          SoulSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  ownerAddress    String     @map("owner_address")
  ownerMemberId   String?    @map("owner_member_id") @db.Uuid
  ownerMember     Member?    @relation("SoulPassSnapshotOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)
  passType        String     @map("pass_type")
  lockedReleaseId String?    @map("locked_release_id")
  expiresAt       DateTime?  @map("expires_at") @db.Timestamptz
  agentGrant      String?    @map("agent_grant")
  status          String     @default("active")
  mintTxDigest    String     @map("mint_tx_digest")
  lastRenewTxDigest String?  @map("last_renew_tx_digest")
  lastSyncedAt    DateTime   @default(now()) @map("last_synced_at") @db.Timestamptz
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([ownerMemberId, status])
  @@index([ownerAddress, status])
  @@index([seriesId, status])
  @@index([seriesId, ownerAddress, status])
  @@index([seriesId, agentGrant, status])
  @@map("soul_pass_snapshots")
}

model SoulTxSync {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeKey    String   @map("route_key")
  txDigest    String   @map("tx_digest")
  actorKey    String   @map("actor_key")
  resourceKey String   @map("resource_key")
  statusCode  Int      @map("status_code")
  responseBody Json    @map("response_body")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([routeKey, txDigest, actorKey, resourceKey])
  @@index([resourceKey, createdAt(sort: Desc)])
  @@map("soul_tx_syncs")
}

model SoulPreparedPurchase {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentMemberId    String   @map("agent_member_id") @db.Uuid
  agentMember      Member   @relation("SoulPreparedPurchaseAgentMember", fields: [agentMemberId], references: [id], onDelete: Cascade)
  seriesOnChainId  String   @map("series_on_chain_id")
  planOnChainId    String   @map("plan_on_chain_id")
  /// `20260322233000_add_soul_enum_checks` constrains plan_type to the supported values in SQL.
  planType         String   @map("plan_type")
  releaseOnChainId String?  @map("release_on_chain_id")
  passOnChainId    String?  @map("pass_on_chain_id")
  agentAddress     String   @map("agent_address")
  /// Stored in atomic 6-decimal USDC units as NUMERIC(20,0) so prepared execution can verify the full on-chain u64 range losslessly.
  /// `20260323090000_add_prepared_purchase_amount_check` enforces strictly positive prepared purchase amounts.
  amountUsdc       Decimal  @map("amount_usdc") @db.Decimal(20, 0)
  /// `20260322123000_add_soul_tx_sync_and_prepared_purchase` caps the stored tx bytes payload length in SQL.
  txBytesBase64    String   @map("tx_bytes_base64")
  txBytesHash      String   @map("tx_bytes_hash")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz
  executedAt       DateTime? @map("executed_at") @db.Timestamptz
  executionTxDigest String? @map("execution_tx_digest")
  resultStatusCode Int?     @map("result_status_code")
  resultBody       Json?    @map("result_body")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([agentMemberId, expiresAt])
  @@index([seriesOnChainId, createdAt(sort: Desc)])
  @@index([executionTxDigest])
  @@unique([agentMemberId, txBytesHash])
  @@map("soul_prepared_purchases")
}
