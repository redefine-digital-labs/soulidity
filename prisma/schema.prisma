generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model RawItem {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceType String    @map("source_type")
  sourceName String    @map("source_name")
  title      String
  url        String    @unique
  titleHash  String?   @map("title_hash")
  content    String?
  language   String    @default("en")
  score      Float     @default(0)
  status     String    @default("new")
  rawData    String?   @map("raw_data")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  articles         Article[]

  @@index([status])
  @@index([score(sort: Desc)])
  @@index([createdAt])
  @@index([titleHash, status, createdAt])
  @@index([sourceType, status, createdAt])
  @@map("raw_items")
}

model CollectorState {
  source       String    @id
  lastPostedAt DateTime? @map("last_posted_at") @db.Timestamptz
  lastTweetId  String?   @map("last_tweet_id")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("collector_states")
}

model Article {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rawItemId    String           @unique @map("raw_item_id") @db.Uuid
  rawItem      RawItem          @relation(fields: [rawItemId], references: [id], onDelete: Cascade)
  titleZh      String           @map("title_zh")
  titleEn      String           @map("title_en")
  summaryZh    String           @map("summary_zh")
  summaryEn    String           @map("summary_en")
  analysisZh   String?          @map("analysis_zh")
  analysisEn   String?          @map("analysis_en")
  tags         String?
  status         String           @default("draft")
  pipelineStatus String           @default("pending") @map("pipeline_status")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  publications   Publication[]
  companies      ArticleCompany[]
  processLogs    AgentProcessLog[]
  posts          Post[]
  @@index([status])
  @@index([pipelineStatus])
  @@map("articles")
}

model AgentRole {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String            @unique
  label       String
  description String?
  sortOrder   Int               @default(0) @map("sort_order")
  logs        AgentProcessLog[]

  @@map("agent_roles")
}

model AgentProcessLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  articleId   String    @map("article_id") @db.Uuid
  article     Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  roleId      String    @map("role_id") @db.Uuid
  role        AgentRole @relation(fields: [roleId], references: [id])
  status      String    @default("pending")
  input       String?
  output      String?
  startedAt   DateTime? @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([articleId])
  @@index([status])
  @@map("agent_process_logs")
}

model Company {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  slug         String           @unique
  description  String?
  website      String?
  logoUrl      String?          @map("logo_url")
  category     String           @default("Other")
  mentionCount Int              @default(0) @map("mention_count")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  articles     ArticleCompany[]

  @@index([category])
  @@index([mentionCount(sort: Desc)])
  @@map("companies")
}

model ArticleCompany {
  articleId String  @map("article_id") @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([articleId, companyId])
  @@map("article_companies")
}

model Publication {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  articleId   String    @map("article_id") @db.Uuid
  article     Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  channel     String
  messageId   String?   @map("message_id")
  publishedAt DateTime? @map("published_at") @db.Timestamptz

  @@index([articleId])
  @@index([publishedAt])
  @@map("publications")
}

model Account {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  privyDid  String?  @unique @map("privy_did")
  tgId      String?  @unique @map("tg_id")
  tgName    String?  @map("tg_name")
  email     String?  @unique
  avatar    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  members               Member[]
  desktopDeviceSessions DesktopDeviceSession[]
  desktopProfile        DesktopProfile?

  @@map("accounts")
}

model Member {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId   String?  @map("account_id") @db.Uuid
  account     Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tgId        String?  @unique @map("tg_id")
  tgName      String?  @map("tg_name")
  level       Int      @default(1)
  avatar      String?
  bio         String?
  exp         Int      @default(0)
  kind        String   @default("human")
  displayName String?  @map("display_name")
  handle      String?  @unique @map("handle")
  twitterUrl  String?  @map("twitter_url")
  websiteUrl  String?  @map("website_url")
  apiKey      String?  @unique @map("api_key")
  apiKeyHash  String?  @unique @map("api_key_hash")
  agentStatus String?  @default("active") @map("agent_status")
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz

  posts        Post[]
  comments     Comment[]
  postVotes    PostVote[]
  achievements MemberAchievement[]
  walletBindings        WalletBinding[]
  authoredSoulAssets    SoulAsset[]           @relation("SoulAssetCreator")
  ownedSoulAssets       SoulAsset[]           @relation("SoulAssetOwner")
  createdSoulCollections SoulCollectionAsset[] @relation("SoulCollectionCreator")
  heldSoulCollections    SoulCollectionAsset[] @relation("SoulCollectionCurrentHolder")
  issuedSoulGrants       SoulGrantRecord[]     @relation("SoulGrantIssuer")
  receivedSoulGrants     SoulGrantRecord[]     @relation("SoulGrantGrantee")
  preparedSoulPurchases SoulPreparedPurchase[] @relation("SoulPreparedPurchaseAgentMember")
  following    Follow[] @relation("follower")
  followers    Follow[] @relation("following")
  bookmarks    Bookmark[]

  @@index([tgId])
  @@index([accountId, kind])
  @@map("members")
}


model Post {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId     String     @map("member_id") @db.Uuid
  member       Member     @relation(fields: [memberId], references: [id])
  title        String
  content      String
  tags         String[]   @default([])
  likeCount    Int        @default(0) @map("like_count")
  commentCount Int        @default(0) @map("comment_count")
  status       String     @default("published")
  type         String     @default("log")
  channel      String     @default("general")
  sourceUrl    String?    @map("source_url")
  articleId    String?    @unique @map("article_id") @db.Uuid
  article      Article?   @relation(fields: [articleId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  comments     Comment[]
  votes        PostVote[]

  @@index([memberId])
  @@index([createdAt])
  @@index([type])
  @@index([channel])
  @@index([tags], type: Gin, map: "posts_tags_gin_idx")
  @@map("posts")
}

model Comment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  memberId  String   @map("member_id") @db.Uuid
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  content    String
  isAccepted Boolean  @default(false) @map("is_accepted")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([postId])
  @@index([memberId])
  @@index([memberId, isAccepted])
  @@map("comments")
}

model PostVote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  memberId  String   @map("member_id") @db.Uuid
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  direction Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([postId, memberId])
  @@index([postId])
  @@map("post_votes")
}

model Achievement {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String              @unique
  nameZh      String              @map("name_zh")
  description String?
  icon        String              @default("🏆")
  condition   String?
  members     MemberAchievement[]

  @@map("achievements")
}

model MemberAchievement {
  memberId      String      @map("member_id") @db.Uuid
  member        Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  achievementId String      @map("achievement_id") @db.Uuid
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  earnedAt      DateTime    @default(now()) @map("earned_at") @db.Timestamptz

  @@id([memberId, achievementId])
  @@map("member_achievements")
}

model Skill {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  displayName String   @map("display_name")
  summary     String
  version     String   @default("1.0.0")
  downloads   Int      @default(0)
  stars       Int      @default(0)
  versions    Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([downloads(sort: Desc)])
  @@index([stars(sort: Desc)])
  @@map("skills")
}

model WalletChallenge {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  address   String
  domain    String?
  nonce     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([address, expiresAt])
  @@map("wallet_challenges")
}

model WalletBinding {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId       String   @map("member_id") @db.Uuid
  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  chain          String   @default("sui")
  address        String
  isPrimary      Boolean  @default(true) @map("is_primary")
  verifiedAt     DateTime @default(now()) @map("verified_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([chain, address])
  @@unique([memberId, chain])
  @@map("wallet_bindings")
}

// ============================================================
// Soul Market Models
// ============================================================

model SoulAsset {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  onChainId             String   @unique @map("on_chain_id")
  stateOnChainId        String   @unique @map("state_on_chain_id")
  memoryOnChainId       String   @unique @map("memory_on_chain_id")
  creatorMemberId       String?  @map("creator_member_id") @db.Uuid
  creatorMember         Member?  @relation("SoulAssetCreator", fields: [creatorMemberId], references: [id], onDelete: SetNull)
  creatorAddress        String   @map("creator_address")
  creatorRoyaltyBps     Int      @default(0) @map("creator_royalty_bps")
  currentOwnerMemberId  String?  @map("current_owner_member_id") @db.Uuid
  currentOwnerMember    Member?  @relation("SoulAssetOwner", fields: [currentOwnerMemberId], references: [id], onDelete: SetNull)
  currentOwnerAddress   String   @map("current_owner_address")
  currentKioskId        String   @map("current_kiosk_id")
  currentKioskCapOnChainId String @map("current_kiosk_cap_on_chain_id")
  /// Hand-managed partial unique index lives in
  /// `prisma/migrations/20260329120000_hard_cut_soul_market_to_stablecoin_listing_objects/migration.sql`
  /// and is tracked in `prisma/MANUAL_INDEXES.md`.
  /// Keep the SQL index in place because Prisma cannot represent the `WHERE ... IS NOT NULL` predicate here.
  listingObjectOnChainId String? @map("listing_object_on_chain_id")
  listedPriceAtomic     Decimal? @map("listed_price_atomic") @db.Decimal(20, 0)
  listingStatus         String   @default("held") @map("listing_status")
  name                  String
  description           String
  imageUrl              String   @map("image_url")
  metadataRef           String?  @map("metadata_ref")
  contentBlobId         String   @map("content_blob_id")
  contentBlobObjectId   String   @map("content_blob_object_id")
  provenanceKind        String   @default("native") @map("provenance_kind")
  originRef             String?  @map("origin_ref")
  collectionOnChainId   String?  @map("collection_on_chain_id")
  collection            SoulCollectionAsset? @relation("CollectionSouls", fields: [collectionOnChainId], references: [onChainId], onDelete: SetNull)
  grantCapacity         Int      @default(1) @map("grant_capacity")
  activeGrantCount      Int      @default(0) @map("active_grant_count")
  skillsOnChainId       String?  @unique @map("skills_on_chain_id")
  assetsOnChainId       String?  @unique @map("assets_on_chain_id")
  accessListOnChainId   String?  @unique @map("access_list_on_chain_id")
  grantRecords          SoulGrantRecord[] @relation("SoulAssetGrantRecords")
  skillVersions         SoulSkillVersionRecord[] @relation("SoulAssetSkillVersions")
  assetVersions         SoulAssetVersionRecord[] @relation("SoulAssetAssetVersions")
  contentAccess         ContentAccessRecord[]    @relation("SoulContentAccess")
  sealSidecar           Json?    @map("seal_sidecar")
  category              String
  tags                  String[]
  previewImages         String[] @map("preview_images")
  readme                String?
  memoryEntries         SoulMemoryEntry[]
  bookmarks             Bookmark[]
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([creatorMemberId, listingStatus])
  @@index([creatorAddress])
  @@index([currentOwnerMemberId, listingStatus])
  @@index([currentOwnerAddress, listingStatus])
  @@index([collectionOnChainId, listingStatus])
  @@index([skillsOnChainId])
  @@index([listingStatus, createdAt(sort: Desc)])
  @@index([currentKioskId, currentKioskCapOnChainId])
  @@index([category])
  @@index([createdAt(sort: Desc)])
  @@map("soul_assets")
}

model SoulCollectionAsset {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  onChainId            String   @unique @map("on_chain_id")
  rightOnChainId       String   @unique @map("right_on_chain_id")
  creatorMemberId      String?  @map("creator_member_id") @db.Uuid
  creatorMember        Member?  @relation("SoulCollectionCreator", fields: [creatorMemberId], references: [id], onDelete: SetNull)
  creatorAddress       String   @map("creator_address")
  currentHolderMemberId String? @map("current_holder_member_id") @db.Uuid
  currentHolderMember  Member?  @relation("SoulCollectionCurrentHolder", fields: [currentHolderMemberId], references: [id], onDelete: SetNull)
  currentHolderAddress String   @map("current_holder_address")
  currentHolderKioskId String   @map("current_holder_kiosk_id")
  name                 String
  description          String
  imageUrl             String   @map("image_url")
  extraRoyaltyBps      Int      @default(0) @map("extra_royalty_bps")
  floorPriceAtomic     Decimal? @map("floor_price_atomic") @db.Decimal(20, 0)
  tradeable            Boolean  @default(true)
  listingObjectOnChainId String? @map("listing_object_on_chain_id")
  listedPriceAtomic    Decimal? @map("listed_price_atomic") @db.Decimal(20, 0)
  listingStatus        String   @default("held") @map("listing_status")
  soulCount            Int      @default(0) @map("soul_count")
  souls                SoulAsset[] @relation("CollectionSouls")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([creatorMemberId, listingStatus])
  @@index([currentHolderMemberId, listingStatus])
  @@index([currentHolderAddress, listingStatus])
  @@index([listingStatus, createdAt(sort: Desc)])
  @@map("soul_collection_assets")
}

model SoulGrantRecord {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  onChainId       String   @unique @map("on_chain_id")
  soulOnChainId   String   @map("soul_on_chain_id")
  soul            SoulAsset @relation("SoulAssetGrantRecords", fields: [soulOnChainId], references: [onChainId], onDelete: Cascade)
  issuedByMemberId String? @map("issued_by_member_id") @db.Uuid
  issuedByMember  Member?  @relation("SoulGrantIssuer", fields: [issuedByMemberId], references: [id], onDelete: SetNull)
  issuedByAddress String   @map("issued_by_address")
  granteeMemberId String?  @map("grantee_member_id") @db.Uuid
  granteeMember   Member?  @relation("SoulGrantGrantee", fields: [granteeMemberId], references: [id], onDelete: SetNull)
  granteeAddress  String   @map("grantee_address")
  scopes          String[]
  status          String   @default("active")
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz
  endedAt         DateTime? @map("ended_at") @db.Timestamptz
  replacedByGrantOnChainId String? @map("replaced_by_grant_on_chain_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([soulOnChainId, status])
  @@index([granteeAddress, status])
  @@index([issuedByAddress, status])
  @@index([replacedByGrantOnChainId])
  @@map("soul_grant_records")
}

model SoulMemoryEntry {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  soulOnChainId  String   @map("soul_on_chain_id")
  soul           SoulAsset @relation(fields: [soulOnChainId], references: [onChainId], onDelete: Cascade)
  memoryOnChainId String  @map("memory_on_chain_id")
  timestampKey   BigInt   @map("timestamp_key")
  writerAddress  String   @map("writer_address")
  writerKind     String   @map("writer_kind")
  blobObjectId   String   @map("blob_object_id")
  blobId         String?  @map("blob_id")
  sealSidecar    Json?    @map("seal_sidecar")
  createdAtMs    BigInt   @map("created_at_ms")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([memoryOnChainId, timestampKey])
  @@index([soulOnChainId, timestampKey(sort: Desc)])
  @@map("soul_memory_entries")
}

model SoulSkillVersionRecord {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  soulOnChainId         String   @map("soul_on_chain_id")
  soul                  SoulAsset @relation("SoulAssetSkillVersions", fields: [soulOnChainId], references: [onChainId], onDelete: Cascade)
  skillsOnChainId       String   @map("skills_on_chain_id")
  skillName             String   @map("skill_name")
  versionIndex          Int      @map("version_index")
  visibility            String
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz
  blobObjectId          String   @map("blob_object_id")
  blobId                String?  @map("blob_id")
  sealSidecar           Json?    @map("seal_sidecar")
  createdAtMs           BigInt   @map("created_at_ms")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([skillsOnChainId, skillName, versionIndex])
  @@index([soulOnChainId, skillName, versionIndex(sort: Desc)])
  @@index([skillsOnChainId])
  @@map("soul_skill_version_records")
}

model SoulTxSync {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeKey    String   @map("route_key")
  txDigest    String   @map("tx_digest")
  actorKey    String   @map("actor_key")
  resourceKey String   @map("resource_key")
  statusCode  Int      @map("status_code")
  responseBody Json    @map("response_body")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([routeKey, txDigest, actorKey, resourceKey])
  @@index([resourceKey, createdAt(sort: Desc)])
  @@map("soul_tx_syncs")
}

model SoulPreparedPurchase {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentMemberId    String   @map("agent_member_id") @db.Uuid
  agentMember      Member   @relation("SoulPreparedPurchaseAgentMember", fields: [agentMemberId], references: [id], onDelete: Cascade)
  soulOnChainId    String   @map("soul_on_chain_id")
  listingObjectId  String   @map("listing_object_id")
  sellerKioskId    String   @map("seller_kiosk_id")
  agentAddress     String   @map("agent_address")
  priceAtomic      Decimal  @map("price_atomic") @db.Decimal(20, 0)
  platformFeeAtomic Decimal @default(0) @map("platform_fee_atomic") @db.Decimal(20, 0)
  creatorRoyaltyAtomic Decimal @default(0) @map("creator_royalty_atomic") @db.Decimal(20, 0)
  totalAtomic      Decimal  @default(0) @map("total_atomic") @db.Decimal(20, 0)
  txBytesBase64    String   @map("tx_bytes_base64")
  txBytesHash      String   @map("tx_bytes_hash")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz
  executedAt       DateTime? @map("executed_at") @db.Timestamptz
  executionTxDigest String? @map("execution_tx_digest")
  resultStatusCode Int?     @map("result_status_code")
  resultBody       Json?    @map("result_body")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([agentMemberId, expiresAt])
  @@index([soulOnChainId, createdAt(sort: Desc)])
  @@index([executionTxDigest])
  @@unique([agentMemberId, txBytesHash])
  @@map("soul_prepared_purchases")
}

// ============================================================
// Social Models
// ============================================================

model Follow {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  follower    Member   @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   Member   @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model Bookmark {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  soulId    String   @map("soul_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  soul      SoulAsset @relation(fields: [soulId], references: [id], onDelete: Cascade)

  @@unique([memberId, soulId])
  @@index([soulId])
  @@map("bookmarks")
}

model SoulAssetVersionRecord {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  soulOnChainId   String    @map("soul_on_chain_id")
  soul            SoulAsset @relation("SoulAssetAssetVersions", fields: [soulOnChainId], references: [onChainId], onDelete: Cascade)
  assetsOnChainId String    @map("assets_on_chain_id")
  assetName       String    @map("asset_name")
  versionIndex    Int       @map("version_index")
  assetType       String    @map("asset_type")
  visibility      String
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  blobObjectId    String    @map("blob_object_id")
  blobId          String?   @map("blob_id")
  sealSidecar     Json?     @map("seal_sidecar")
  createdAtMs     BigInt    @map("created_at_ms")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([assetsOnChainId, assetName, versionIndex], map: "soul_asset_version_unique")
  @@index([soulOnChainId, assetName, versionIndex(sort: Desc)])
  @@map("soul_asset_version_records")
}

model ContentAccessRecord {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  soulOnChainId       String    @map("soul_on_chain_id")
  soul                SoulAsset @relation("SoulContentAccess", fields: [soulOnChainId], references: [onChainId], onDelete: Cascade)
  accessListOnChainId String    @map("access_list_on_chain_id")
  granteeAddress      String    @map("grantee_address")
  scopeMask           Int       @map("scope_mask")
  pricePaidAtomic     BigInt    @map("price_paid_atomic")
  grantedAtMs         BigInt    @map("granted_at_ms")
  expiresAtMs         BigInt?   @map("expires_at_ms")
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([accessListOnChainId, granteeAddress], map: "content_access_unique")
  @@index([soulOnChainId])
  @@index([granteeAddress])
  @@map("content_access_records")
}

