generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model RawItem {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceType String    @map("source_type")
  sourceName String    @map("source_name")
  title      String
  url        String    @unique
  titleHash  String?   @map("title_hash")
  content    String?
  language   String    @default("en")
  score      Float     @default(0)
  status     String    @default("new")
  rawData    String?   @map("raw_data")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  articles         Article[]
  knowledgeSources KnowledgeEntrySource[]

  @@index([status])
  @@index([score(sort: Desc)])
  @@index([createdAt])
  @@map("raw_items")
}

model CollectorState {
  source       String    @id
  lastPostedAt DateTime? @map("last_posted_at") @db.Timestamptz
  lastTweetId  String?   @map("last_tweet_id")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("collector_states")
}

model Article {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rawItemId    String           @map("raw_item_id") @db.Uuid
  rawItem      RawItem          @relation(fields: [rawItemId], references: [id], onDelete: Cascade)
  titleZh      String           @map("title_zh")
  titleEn      String           @map("title_en")
  summaryZh    String           @map("summary_zh")
  summaryEn    String           @map("summary_en")
  analysisZh   String?          @map("analysis_zh")
  analysisEn   String?          @map("analysis_en")
  tags         String?
  status         String           @default("draft")
  pipelineStatus String           @default("pending") @map("pipeline_status")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  publications   Publication[]
  companies      ArticleCompany[]
  processLogs    AgentProcessLog[]
  directionId    String?           @map("direction_id") @db.Uuid
  direction      Direction?        @relation(fields: [directionId], references: [id])

  @@index([status])
  @@index([directionId])
  @@map("articles")
}

model AgentRole {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String            @unique
  label       String
  description String?
  sortOrder   Int               @default(0) @map("sort_order")
  logs        AgentProcessLog[]

  @@map("agent_roles")
}

model AgentProcessLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  articleId   String    @map("article_id") @db.Uuid
  article     Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  roleId      String    @map("role_id") @db.Uuid
  role        AgentRole @relation(fields: [roleId], references: [id])
  status      String    @default("pending")
  input       String?
  output      String?
  startedAt   DateTime? @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([articleId])
  @@index([status])
  @@map("agent_process_logs")
}

model Company {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  slug         String           @unique
  description  String?
  website      String?
  logoUrl      String?          @map("logo_url")
  category     String           @default("Other")
  mentionCount Int              @default(0) @map("mention_count")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  articles     ArticleCompany[]

  @@index([category])
  @@index([mentionCount(sort: Desc)])
  @@map("companies")
}

model ArticleCompany {
  articleId String  @map("article_id") @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([articleId, companyId])
  @@map("article_companies")
}

model Publication {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  articleId   String    @map("article_id") @db.Uuid
  article     Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  channel     String
  messageId   String?   @map("message_id")
  publishedAt DateTime? @map("published_at") @db.Timestamptz

  @@map("publications")
}

model Member {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tgId       String   @unique @map("tg_id")
  tgName     String?  @map("tg_name")
  wallet     String?
  level      Int      @default(1)
  inviteCode String?  @map("invite_code")
  avatar     String?
  bio        String?
  exp        Int      @default(0)
  joinedAt   DateTime @default(now()) @map("joined_at") @db.Timestamptz

  posts        Post[]
  comments     Comment[]
  achievements MemberAchievement[]
  loginChallenges LoginChallenge[]

  @@index([tgId])
  @@map("members")
}

model LoginChallenge {
  token      String    @id
  tgId       String?   @map("tg_id")
  memberId   String?   @map("member_id") @db.Uuid
  member     Member?   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status     String    @default("pending")
  error      String?
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([memberId])
  @@index([expiresAt])
  @@map("login_challenges")
}

model InviteCode {
  code      String    @id
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime? @map("expires_at") @db.Timestamptz
  usedBy    String?   @map("used_by")
  active    Int       @default(1)

  @@map("invite_codes")
}

model Category {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String      @unique
  nameZh      String      @map("name_zh")
  icon        String      @default("📦")
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  directions  Direction[]

  @@map("categories")
}

model Direction {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  category      Category @relation(fields: [categoryId], references: [id])
  name          String
  nameZh        String   @map("name_zh")
  slug          String   @unique
  description   String?
  descriptionZh String?  @map("description_zh")
  icon          String   @default("🔧")
  userCount     Int      @default(0) @map("user_count")
  rating        Float    @default(0)
  featured      Boolean  @default(false)
  status        String   @default("active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  posts         Post[]
  articles      Article[]

  @@index([categoryId])
  @@index([userCount(sort: Desc)])
  @@index([rating(sort: Desc)])
  @@index([featured])
  @@map("directions")
}

model Post {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId     String     @map("member_id") @db.Uuid
  member       Member     @relation(fields: [memberId], references: [id])
  directionId  String?    @map("direction_id") @db.Uuid
  direction    Direction? @relation(fields: [directionId], references: [id])
  title        String
  content      String
  tags         String?
  likeCount    Int        @default(0) @map("like_count")
  commentCount Int        @default(0) @map("comment_count")
  status       String     @default("published")
  type         String     @default("log")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  comments     Comment[]

  @@index([memberId])
  @@index([directionId])
  @@index([createdAt])
  @@index([type])
  @@map("posts")
}

model Comment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  memberId  String   @map("member_id") @db.Uuid
  member    Member   @relation(fields: [memberId], references: [id])
  content    String
  isAccepted Boolean  @default(false) @map("is_accepted")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([postId])
  @@map("comments")
}

model Achievement {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String              @unique
  nameZh      String              @map("name_zh")
  description String?
  icon        String              @default("🏆")
  condition   String?
  members     MemberAchievement[]

  @@map("achievements")
}

model MemberAchievement {
  memberId      String      @map("member_id") @db.Uuid
  member        Member      @relation(fields: [memberId], references: [id])
  achievementId String      @map("achievement_id") @db.Uuid
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  earnedAt      DateTime    @default(now()) @map("earned_at") @db.Timestamptz

  @@id([memberId, achievementId])
  @@map("member_achievements")
}

model KnowledgeEntry {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  content      String
  category     String
  contentType  String                 @map("content_type")
  status       String                 @default("raw")
  mergedIntoId String?                @map("merged_into_id") @db.Uuid
  mergedInto   KnowledgeEntry?        @relation("KnowledgeMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   KnowledgeEntry[]       @relation("KnowledgeMerge")
  sources      KnowledgeEntrySource[]
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([category])
  @@index([contentType])
  @@index([status])
  @@map("knowledge_entries")
}

model KnowledgeEntrySource {
  entryId   String         @map("entry_id") @db.Uuid
  entry     KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  rawItemId String         @map("raw_item_id") @db.Uuid
  rawItem   RawItem        @relation(fields: [rawItemId], references: [id], onDelete: Cascade)

  @@id([entryId, rawItemId])
  @@map("knowledge_entry_sources")
}

model Skill {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  displayName String   @map("display_name")
  summary     String
  version     String   @default("1.0.0")
  downloads   Int      @default(0)
  stars       Int      @default(0)
  versions    Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([downloads(sort: Desc)])
  @@index([stars(sort: Desc)])
  @@map("skills")
}
