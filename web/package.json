    "@prisma/client": "^7.7.0",
    "@tanstack/react-query": "^5.99.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/blob": "^2.3.3",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.2",
    "grammy": "^1.42.0",
    "jose": "^6.2.1",
    "next": "^16.2.4",
    "openai": "^6.34.0",
    "pg": "^8.20.0",
