{
  "name": "soulidity-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy-walrus-wasm": "node scripts/copy-walrus-wasm.mjs",
    "dev": "next dev --port 3100",
    "predev": "npm run copy-walrus-wasm",
    "prisma:generate": "prisma generate --schema=../prisma/schema.prisma",
    "prisma:migrate:deploy": "cd .. && prisma migrate deploy --schema=prisma/schema.prisma",
    "typegen": "next typegen",
    "typecheck": "npm run prisma:generate && npm run typegen && tsc -p tsconfig.json --noEmit",
    "build:vercel": "npm run prisma:migrate:deploy && npm run build",
    "build": "npm run prisma:generate && next build --webpack",
    "prebuild": "npm run copy-walrus-wasm",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@mysten/dapp-kit": "^1.0.4",
    "@mysten/seal": "^1.1.1",
    "@mysten/sui": "^2.16.0",
    "@mysten/wallet-standard": "^0.20.1",
    "@mysten/walrus": "^1.1.3",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.8.0",
    "@soulidity/sdk": "file:../packages/soulidity-sdk",
    "@tanstack/react-query": "^5.99.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/blob": "^2.3.3",
    "@wallet-standard/base": "^1.1.0",
    "@wallet-standard/features": "^1.1.0",
    "@wallet-standard/wallet": "^1.1.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.2",
    "grammy": "^1.42.0",
    "jose": "^6.2.1",
    "next": "^16.2.10",
    "openai": "^6.34.0",
    "posthog-js": "^1.399.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "read-excel-file": "^9.0.6",
    "server-only": "^0.0.1",
    "write-excel-file": "^4.0.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "knip": "^6.11.0",
    "postcss": "^8.5.12",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^6"
  },
  "overrides": {
    "@hono/node-server": "1.19.14",
    "axios": "1.15.0",
    "follow-redirects": "1.16.0",
    "hono": "4.12.29",
    "postcss": "^8.5.12"
  }
}
