    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@mysten/dapp-kit": "^1.0.4",
    "@mysten/seal": "^1.1.1",
    "@mysten/sui": "^2.15.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@privy-io/react-auth": "^3.20.0",
    "@privy-io/server-auth": "^1.32.5",
    "@tanstack/react-query": "^5.96.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.1",
    "fflate": "^0.8.2",
    "grammy": "^1.42.0",
    "jose": "^6.2.1",
    "next": "^16.2.3",
    "openai": "^6.34.0",
    "pg": "^8.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "read-excel-file": "^8.0.3",
    "write-excel-file": "^3.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
