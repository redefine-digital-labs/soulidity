# Database (Supabase Postgres)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres    # Prisma migrations/introspection
SHADOW_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres_shadow    # Disposable shadow DB for Prisma migrate diff/dev

# Supabase (Auth + Real-time only)
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Telegram
TG_BOT_TOKEN=123456:ABC...
TG_CHANNEL_ID=-100...

# Community Auth
NEXT_PUBLIC_TG_BOT_USERNAME=COCcommunityBot
AUTH_SECRET=replace-with-a-random-secret    # Required for agent claim token signing AND human session cookie signing

# X (Twitter) data source
X_DATABASE_URL=postgresql://...    # External Supabase for X tweet data

# Producer LLM (local collector/producer flow)
OPENAI_API_KEY=sk-...              # Required for npm run produce / src/main.ts
OPENAI_MODEL=gpt-5.3-codex-spark   # Optional; defaults to GPT-5.3-Codex-Spark
OPENAI_BASE_URL=                   # Optional OpenAI-compatible endpoint override

# Web admin LLM (admin submit / tweet approve)
DEFAULT_PROVIDER=deepseek-v4-flash  # Existing production key; accepts "deepseek" or a DeepSeek model id
DEEPSEEK_API_KEY=sk-...            # Required for web admin generation
DEEPSEEK_MODEL=                    # Optional explicit model override
DEEPSEEK_BASE_URL=https://api.deepseek.com

# App
NEXT_PUBLIC_BASE_URL=https://clawnews-mu.vercel.app  # Used for register URLs in bot messages
APP_DOMAIN=clawnews-mu.vercel.app    # Optional trusted domain override for wallet challenge signing
SOULIDITY_WEB_URL=http://localhost:3000  # Desktop main-process web API base URL override
TRUST_PROXY_HEADERS=false    # Set true only behind a trusted reverse proxy that overwrites client IP headers

# Sui
NEXT_PUBLIC_SUI_NETWORK=testnet                      # testnet | mainnet
# Soulidity deployment IDs are sourced from web/lib/soulidity/deployment-manifest.json
NEXT_PUBLIC_KIOSK_PACKAGE_ID=0xdfb4f1d4e43e0c3ad834dcd369f0d39005c872e118c9dc1c5da9765bb93ee5f3 # Mainnet MystenLabs/apps kiosk latest package; testnet uses the package linked by its deployed Soulidity package
MAINNET_DEPLOYER_PRIV_KEY=                           # Sui private key (suiprivkey1.../base64/hex) for one-shot mainnet publish; transferred to multisig immediately after. NEVER commit a real value.
NEXT_PUBLIC_SEAL_SERVER_CONFIGS=[{"objectId":"0x145540d931f182fef76467dd8074c9839aea126852d90d18e1556fcbbd1208b6","weight":1}]
SEAL_SERVER_CONFIGS=    # Optional server-only overrides for aggregatorUrl/apiKeyName/apiKey
NEXT_PUBLIC_SEAL_THRESHOLD=1
NEXT_PUBLIC_SEAL_VERIFY_KEY_SERVERS=true
NEXT_PUBLIC_SEAL_SESSION_TTL_MIN=10
SOUL_UPLOAD_SECRET=                    # 32-byte hex key for DEK envelope encryption during Soul uploads
WALRUS_PUBLISHER_URL=
WALRUS_AGGREGATOR_URL=

# Admin
# At least one of ADMIN_EMAILS or ADMIN_WALLET_ADDRESSES must be set; both are honored.
ADMIN_EMAILS=admin@example.com                # Comma-separated admin emails (matched against Account.email)
ADMIN_WALLET_ADDRESSES=                       # Comma-separated admin Sui addresses (matched against the member's primary wallet binding)

# Desktop download distribution
# The /download page reads a JSON manifest (published by web/scripts/upload-desktop-dmg.ts)
# from a stable Vercel Blob URL, so new Desktop releases don't require a Web redeploy.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...    # Vercel Blob rw token (server-only); used by web/scripts/upload-desktop-dmg.ts
DESKTOP_MANIFEST_URL=                       # Public URL of desktop/manifest.json on Vercel Blob; set ONCE after first upload
NEXT_PUBLIC_DESKTOP_MAC_ARM64_URL=          # Fallback dmg URL when DESKTOP_MANIFEST_URL is unreachable; safe to leave empty
NEXT_PUBLIC_DESKTOP_VERSION=0.0.4           # Fallback version label when DESKTOP_MANIFEST_URL is unreachable
