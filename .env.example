# Database (Supabase Postgres)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres    # Prisma migrations/introspection
SHADOW_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres_shadow    # Disposable shadow DB for Prisma migrate diff/dev

# Supabase (Auth + Real-time only)
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Telegram
TG_BOT_TOKEN=123456:ABC...
TG_CHANNEL_ID=-100...

# Community Auth
NEXT_PUBLIC_TG_BOT_USERNAME=COCcommunityBot
AUTH_SECRET=replace-with-a-random-secret    # Required for agent claim token signing AND human session cookie signing

# X (Twitter) data source
X_DATABASE_URL=postgresql://...    # External Supabase for X tweet data

# LLM (shared by npm run produce / src/main.ts and web admin submit / tweet approve)
DEFAULT_PROVIDER=deepseek-v4-flash  # Accepts "deepseek" or a DeepSeek model id
DEEPSEEK_API_KEY=sk-...             # Required for producer (npm run produce / src/main.ts) and web admin generation
DEEPSEEK_MODEL=                     # Optional explicit model override
DEEPSEEK_BASE_URL=https://api.deepseek.com

# App
NEXT_PUBLIC_BASE_URL=https://www.soulidity.ai  # Used for register URLs in bot messages
APP_DOMAIN=www.soulidity.ai    # Optional trusted domain override for wallet challenge signing
SOULIDITY_WEB_URL=http://localhost:3000  # Desktop main-process web API base URL override
TRUST_PROXY_HEADERS=false    # Set true only behind a trusted reverse proxy that overwrites client IP headers

# Sui
NEXT_PUBLIC_SUI_NETWORK=testnet                      # testnet | mainnet
# Soulidity deployment IDs are sourced from web/lib/soulidity/deployment-manifest.json
NEXT_PUBLIC_KIOSK_PACKAGE_ID= # Optional override. Defaults via NEXT_PUBLIC_SUI_NETWORK: mainnet=0xdfb4f1d4e43e0c3ad834dcd369f0d39005c872e118c9dc1c5da9765bb93ee5f3 (MystenLabs/apps), testnet=0xc9f6a531d5f4e11ef38dd782c9ab5403fb3c011595384c429285952ff6b31839 (vendored kiosk linked into Soulidity testnet)
MAINNET_DEPLOYER_PRIV_KEY=                           # Sui private key (suiprivkey1.../base64/hex) for one-shot mainnet publish; transferred to multisig immediately after. NEVER commit a real value.
# Animacraft canonical mint adapter. Keep the release gate false until both
# reviewed package upgrades are published and these shared object IDs are verified.
NEXT_PUBLIC_ANIMACRAFT_CANONICAL_MINT_ENABLED=false
NEXT_PUBLIC_ANIMACRAFT_PACKAGE_ID=
NEXT_PUBLIC_ANIMACRAFT_PROTOCOL_FEE_CONFIG_ID=
NEXT_PUBLIC_ANIMACRAFT_PROTOCOL_TREASURY_ID=
NEXT_PUBLIC_SEAL_SERVER_CONFIGS=[{"objectId":"0x145540d931f182fef76467dd8074c9839aea126852d90d18e1556fcbbd1208b6","weight":1}]
SEAL_SERVER_CONFIGS=    # Optional server-only overrides for aggregatorUrl/apiKeyName/apiKey
NEXT_PUBLIC_SEAL_THRESHOLD=1
NEXT_PUBLIC_SEAL_VERIFY_KEY_SERVERS=true
NEXT_PUBLIC_SEAL_SESSION_TTL_MIN=10
SOUL_UPLOAD_SECRET=                    # 32-byte hex key for DEK envelope encryption during Soul uploads
WALRUS_PUBLISHER_URL=
WALRUS_AGGREGATOR_URL=
NEXT_PUBLIC_WALRUS_UPLOAD_TRANSPORT=managed   # Production default. Set 'browser' for emergency direct upload rollback or 'server' for legacy /api/walrus/batch/complete diagnostics.
NEXT_PUBLIC_WALRUS_UPLOADER_URL=https://uploader.soulidity.ai
WALRUS_UPLOADER_TOKEN_SECRET=                 # Shared HMAC secret for /api/walrus/upload-token and walrus-uploader. Required when transport=managed.
WALRUS_UPLOADER_TOKEN_TTL_MS=300000
WALRUS_UPLOADER_TOKEN_MAX_FILES=64
WALRUS_UPLOADER_TOKEN_MAX_BYTES=536870912

# walrus-uploader service only. Cloud Run staging tests default to GCS.
STAGING_BACKEND=gcs                           # gcs for Cloud Run; filesystem only for local diagnostics.
UPLOAD_DATA_DIR=                              # Filesystem staging path for local diagnostics only.
GCS_BUCKET=
GCS_PREFIX=walrus-uploader
UPLOAD_STAGE_TTL_MS=86400000
CORS_ORIGIN=https://www.soulidity.ai
SUI_FULLNODE_URL=

# Admin
# At least one of ADMIN_EMAILS or ADMIN_WALLET_ADDRESSES must be set; both are honored.
ADMIN_EMAILS=admin@example.com                # Comma-separated admin emails (matched against Account.email)
ADMIN_WALLET_ADDRESSES=                       # Comma-separated admin Sui addresses (matched against the member's primary wallet binding)

# Desktop download distribution
# The /download page reads a JSON manifest (published by web/scripts/upload-desktop-dmg.ts)
# from a stable Vercel Blob URL, so new Desktop releases don't require a Web redeploy.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...    # Vercel Blob rw token (server-only); used by web/scripts/upload-desktop-dmg.ts
DESKTOP_MANIFEST_URL=                       # Public URL of desktop/manifest.json on Vercel Blob; set ONCE after first upload
NEXT_PUBLIC_DESKTOP_MAC_ARM64_URL=          # Fallback dmg URL when DESKTOP_MANIFEST_URL is unreachable; safe to leave empty
NEXT_PUBLIC_DESKTOP_VERSION=0.0.4           # Fallback version label when DESKTOP_MANIFEST_URL is unreachable

# Observability — PostHog Cloud US
# Frontend uses /ingest as proxied host (rewritten by next.config.ts to us.i.posthog.com)
# The browser-facing key MUST be set explicitly via NEXT_PUBLIC_POSTHOG_KEY — the
# server-side POSTHOG_API_KEY is no longer copied into the client bundle, so a
# server-only key is never inlined into browser JavaScript.
# Backend modules fall back to POSTHOG_API_KEY when POSTHOG_SERVER_KEY is unset.
# Leave both POSTHOG_API_KEY and NEXT_PUBLIC_POSTHOG_KEY empty to disable telemetry.
POSTHOG_API_KEY=                            # phc_... project token; backend ingestion (server-only)
NEXT_PUBLIC_POSTHOG_KEY=                    # phc_... project token; REQUIRED to enable browser analytics
NEXT_PUBLIC_POSTHOG_HOST=/ingest            # Use /ingest in prod (proxy); set https://us.i.posthog.com to bypass proxy in dev
POSTHOG_SERVER_KEY=                         # Optional explicit override for backend (defaults to POSTHOG_API_KEY)
