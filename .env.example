# Database (Supabase Postgres)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres    # Prisma migrations/introspection
SHADOW_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres_shadow    # Disposable shadow DB for Prisma migrate diff/dev

# Supabase (Auth + Real-time only)
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Telegram
TG_BOT_TOKEN=123456:ABC...
TG_CHANNEL_ID=-100...

# Community Auth
NEXT_PUBLIC_TG_BOT_USERNAME=COCcommunityBot
AUTH_SECRET=replace-with-a-random-secret    # Required for agent claim token signing

# X (Twitter) data source
X_DATABASE_URL=postgresql://...    # External Supabase for X tweet data

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
# App
NEXT_PUBLIC_BASE_URL=https://clawnews-mu.vercel.app  # Used for register URLs in bot messages
APP_DOMAIN=clawnews-mu.vercel.app    # Optional trusted domain override for wallet challenge signing
TRUST_PROXY_HEADERS=false    # Set true only behind a trusted reverse proxy that overwrites client IP headers

# Sui
NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_SOUL_OBJECT_PACKAGE_ID=0x...             # Soul package ID
NEXT_PUBLIC_SOUL_MARKET_ADAPTER_PACKAGE_ID=0x...     # Soul market adapter package ID
NEXT_PUBLIC_SOUL_MARKET_CONFIG_ID=0x...              # soul_object::market::MarketConfig shared object ID
NEXT_PUBLIC_SOUL_COLLECTION_ID=0x...                 # NftCollection<Soul> shared object ID
NEXT_PUBLIC_SOUL_TRANSFER_POLICY_ID=0x...            # TransferPolicy<Soul> shared object ID
NEXT_PUBLIC_SOUL_ALLOWLIST_REGISTRY_ID=0x...         # AllowlistRegistry shared object ID
NEXT_PUBLIC_SOUL_PAYMENT_COIN_TYPE=0x0::usdc::USDC   # Official payment coin type; testnet binds to test USDC
NEXT_PUBLIC_KIOSK_PACKAGE_ID=0x...                   # Kiosk package address (required in deployments without the vendored Move.toml)
NEXT_PUBLIC_SEAL_SERVER_CONFIGS=[{"objectId":"0x73d05d62c18d9374e3ea529e8e0ed6161da1a141a94d3f76ae3fe4e99356db75","weight":1}]
SEAL_SERVER_CONFIGS=    # Optional server-only overrides for aggregatorUrl/apiKeyName/apiKey
NEXT_PUBLIC_SEAL_THRESHOLD=1
NEXT_PUBLIC_SEAL_VERIFY_KEY_SERVERS=true
NEXT_PUBLIC_SEAL_SESSION_TTL_MIN=10
SOUL_UPLOAD_SECRET=                    # 32-byte hex key for DEK envelope encryption during Soul uploads
WALRUS_PUBLISHER_URL=
WALRUS_AGGREGATOR_URL=

# Admin
ADMIN_EMAILS=admin@example.com    # Comma-separated list of admin emails

# Review Memory (mem9)
MEM9_API_URL=http://localhost:8080
MEM9_API_KEY=local-dev-tenant-id-replace-in-production    # Replace for any non-local mem9 tenant
REVIEW_MEMORY_REPO_ID=clawnews
REVIEW_MEMORY_AGENT_NAME=review-memory-mcp
