{
  "name": "@soulidity/desktop",
  "version": "0.0.4",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "pnpm run build:backend && pnpm run build:skills && electron-vite dev",
    "build": "pnpm run build:backend && electron-vite build",
    "preview": "electron-vite preview",
    "package": "pnpm run package:mac",
    "package:mac": "node scripts/assert-mac-release-env.mjs && pnpm run build:backend && pnpm run build:skills && electron-vite build && electron-builder --mac",
    "package:mac:unsigned": "SOULIDITY_ALLOW_UNSIGNED_MAC_BUILD=1 pnpm run build:backend && pnpm run build:skills && electron-vite build && electron-builder --mac -c.mac.identity=null -c.mac.notarize=false",
    "package:win": "pnpm run build:backend && pnpm run build:skills && electron-vite build && electron-builder --win",
    "build:backend": "pnpm --filter @soulidity/backend run build",
    "build:shared": "pnpm --filter @soulidity/shared run build",
    "build:skills": "node ../../scripts/build-skills.mjs && tsc -p ../../packages/backend/src/agent/skills/tsconfig.scripts.json",
    "typecheck": "pnpm run build:shared && pnpm run build:backend && tsc -p ../../packages/backend/tsconfig.json --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "e2e": "playwright test"
  },
  "build": {
    "appId": "com.soulidity.desktop",
    "productName": "Soulidity Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/persona",
        "to": "persona"
      },
      {
        "from": "resources/skills",
        "to": "skills"
      },
      {
        "from": "resources/hooks",
        "to": "hooks"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "fabw222",
        "repo": "clawnews"
      }
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Soulidity Desktop"
    }
  },
  "dependencies": {
    "@mysten/dapp-kit": "^1.0.4",
    "@mysten/seal": "^1.1.1",
    "@mysten/sui": "2.16.0",
    "@soulidity/backend": "workspace:*",
    "@soulidity/shared": "workspace:*",
    "@tanstack/react-query": "5.100.6",
    "chokidar": "^5.0.0",
    "electron-store": "11.0.2",
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "41.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "5.0.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "typescript": "6.0.3",
    "vite": "7.3.2"
  }
}
